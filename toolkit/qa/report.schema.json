{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema",
    "status",
    "presentation_allowed"
  ],
  "properties": {
    "schema": {
      "const": "qa-report/1"
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "ERROR"
      ]
    },
    "presentation_allowed": {
      "type": "boolean"
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "status",
          "value",
          "threshold",
          "frames",
          "detail",
          "unit"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "UNAVAILABLE"
            ]
          },
          "value": {
            "type": [
              "number",
              "null"
            ]
          },
          "threshold": {
            "type": [
              "number",
              "null"
            ]
          },
          "unit": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "frames": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          }
        }
      }
    },
    "failed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unavailable": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "calibration": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "FAIL",
              "BLOCKED",
              "ERROR"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "presentation_allowed": {
            "const": false
          }
        }
      }
    }
  ]
}
