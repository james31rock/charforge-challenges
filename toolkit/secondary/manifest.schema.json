{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CharForge S7 output",
  "type": "object",
  "required": [
    "schema_version",
    "stage",
    "status",
    "bake_revision",
    "character_id",
    "measurements",
    "motion",
    "fps",
    "frames",
    "simulation_hz",
    "source_sha256",
    "source_motion_sha256",
    "chains",
    "colliders",
    "outputs",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "stage": {
      "const": "S7"
    },
    "status": {
      "const": "candidate"
    },
    "bake_revision": {
      "const": "actual-rest-segment-v2"
    },
    "character_id": {
      "type": "string",
      "minLength": 1
    },
    "measurements": {
      "type": "object",
      "required": [
        "height_cm",
        "mass_proxy_kg"
      ],
      "properties": {
        "height_cm": {
          "type": "number",
          "minimum": 10,
          "maximum": 1000
        },
        "mass_proxy_kg": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "motion": {
      "type": "string"
    },
    "fps": {
      "type": "integer",
      "minimum": 12
    },
    "frames": {
      "type": "integer",
      "minimum": 2
    },
    "simulation_hz": {
      "type": "integer",
      "minimum": 120
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_motion_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "chains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "preset",
          "bones",
          "resolved",
          "metrics"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "preset": {
            "type": "string"
          },
          "bones": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "resolved": {
            "type": "object",
            "required": [
              "length_m",
              "omega",
              "radius_m",
              "stiffness_n_m",
              "damping_n_s_m"
            ]
          },
          "metrics": {
            "type": "object",
            "required": [
              "finite",
              "constraint_pass",
              "proxy_collision_pass",
              "jitter_pass",
              "settle_pass",
              "explosion_pass",
              "garment_surface_gate"
            ],
            "properties": {
              "finite": {
                "type": "boolean"
              },
              "constraint_pass": {
                "type": "boolean"
              },
              "proxy_collision_pass": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "jitter_pass": {
                "type": "boolean"
              },
              "settle_pass": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "explosion_pass": {
                "type": "boolean"
              },
              "garment_surface_gate": {
                "const": "not-tested-by-particle-proxies"
              }
            }
          }
        }
      }
    },
    "colliders": {
      "type": "array"
    },
    "outputs": {
      "type": "object",
      "required": [
        "blend",
        "cache"
      ]
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
